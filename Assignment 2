-- ============================================================
-- MySQL DB Select Query Assignment (MCA 3rd) - MySQL Client 8.0
-- Uses the 'hr' database (table: employees)
-- Run with:  mysql -u root -p < mysql_select_assignment2.sql
-- ============================================================
USE hr;

-- Q1. Names with alias "First Name", "Last Name"
SELECT first_name AS `First Name`,
       last_name  AS `Last Name`
FROM employees;

-- Q2. Unique department IDs
SELECT DISTINCT department_id
FROM employees;

-- Q3. All employee details ordered by first name, descending
SELECT *
FROM employees
ORDER BY first_name DESC;

-- Q4. Names, salary and PF (15% of salary)
SELECT first_name, last_name, salary,
       salary * 0.15 AS PF
FROM employees;

-- Q5. Employee ID, names, salary in ascending order of salary
SELECT employee_id, first_name, last_name, salary
FROM employees
ORDER BY salary ASC;

-- Q6. Total salaries payable to employees
SELECT SUM(salary) AS total_salary
FROM employees;

-- Q7. Maximum and minimum salary
SELECT MAX(salary) AS max_salary,
       MIN(salary) AS min_salary
FROM employees;

-- Q8. Average salary and number of employees
SELECT AVG(salary) AS avg_salary,
       COUNT(*)    AS num_employees
FROM employees;

-- Q9. Number of employees working with the company
SELECT COUNT(*) AS num_employees
FROM employees;

-- Q10. Number of jobs available in the employees table
SELECT COUNT(DISTINCT job_id) AS num_jobs
FROM employees;

-- Q11. All first names in upper case
SELECT UPPER(first_name) AS first_name_upper
FROM employees;

-- Q12. First 3 characters of first name
SELECT SUBSTRING(first_name, 1, 3) AS first_3_chars
FROM employees;

-- Q13. Calculate 171*214+625
SELECT 171 * 214 + 625 AS result;

-- Q14. Full names (e.g. Ellen Abel)
SELECT CONCAT(first_name, ' ', last_name) AS name
FROM employees;

-- Q15. First name after removing white spaces from both sides
SELECT TRIM(first_name) AS first_name_trimmed
FROM employees;

-- Q16. Length of employee names (first_name, last_name)
SELECT first_name, last_name,
       LENGTH(CONCAT(first_name, ' ', last_name)) AS name_length
FROM employees;
-- Alternative: separate lengths
-- SELECT first_name, LENGTH(first_name) AS fn_len,
--        last_name,  LENGTH(last_name)  AS ln_len
-- FROM employees;

-- Q17. Check whether first_name contains numbers
SELECT *
FROM employees
WHERE first_name REGEXP '[0-9]';

-- Q18. First 10 records from a table
SELECT *
FROM employees
LIMIT 10;

-- Q19. Monthly salary rounded to 2 decimals (salary is annual)
SELECT first_name, last_name,
       ROUND(salary / 12, 2) AS monthly_salary
FROM employees;
