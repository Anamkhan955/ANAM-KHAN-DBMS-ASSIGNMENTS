-- ============================================================
-- MySQL DB Select Query Assignment 3 - MySQL Client 8.0
-- Uses the 'hr' database (table: employees)
-- Run with:  mysql -u root -p < mysql_select_assignment3.sql
-- ============================================================
USE hr;

-- Q1. Name and salary of employees whose salary is NOT in the range 10000 to 15000
SELECT first_name, last_name, salary
FROM employees
WHERE salary NOT BETWEEN 10000 AND 15000;

-- Q2. Name and department ID of employees in departments 30 or 100, ascending order
SELECT first_name, last_name, department_id
FROM employees
WHERE department_id IN (30, 100)
ORDER BY department_id ASC;

-- Q3. Salary NOT in 10000-15000 AND in department 30 or 100
SELECT first_name, last_name, salary
FROM employees
WHERE salary NOT BETWEEN 10000 AND 15000
  AND department_id IN (30, 100);

-- Q4. Name and hire date of employees hired in 1987
SELECT first_name, last_name, hire_date
FROM employees
WHERE YEAR(hire_date) = 1987;

-- Q5. First names that contain both 'b' and 'c'
SELECT first_name
FROM employees
WHERE first_name LIKE '%b%'
  AND first_name LIKE '%c%';

-- Q6. Last name, job and salary for Programmers or Shipping Clerks
--     whose salary is not 4500, 10000 or 15000
--     (in the hr database: IT_PROG = Programmer, SH_CLERK = Shipping Clerk)
SELECT last_name, job_id, salary
FROM employees
WHERE job_id IN ('IT_PROG', 'SH_CLERK')
  AND salary NOT IN (4500, 10000, 15000);

-- Q7. Last names with exactly 6 characters
SELECT last_name
FROM employees
WHERE LENGTH(last_name) = 6;

-- Q8. Last names having 'e' as the third character
SELECT last_name
FROM employees
WHERE last_name LIKE '__e%';

-- Q9. Jobs/designations available in the employees table
SELECT DISTINCT job_id
FROM employees;

-- Q10. Name, salary and PF (15% of salary)
SELECT first_name, last_name, salary,
       salary * 0.15 AS PF
FROM employees;

-- Q11. All records where last name is BLAKE, SCOTT, KING or FORD
SELECT *
FROM employees
WHERE last_name IN ('BLAKE', 'SCOTT', 'KING', 'FORD');
